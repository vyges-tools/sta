create_clock -name clk_i -period 2.5 -waveform {0.2 1.4} [get_ports {clk_i}]
create_generated_clock -name g3 -source [get_ports {clk_i}] -master_clock clk_i -multiply_by 3 -duty_cycle 40 -add [get_ports {clk_i}]
create_generated_clock -name gi -source [get_ports {clk_i}] -master_clock clk_i -divide_by 3 -invert -add [get_ports {clk_i}]
create_generated_clock -name ge -source [get_ports {clk_i}] -master_clock clk_i -edges {1 3 5} -edge_shift {0.1 0.3 0.1} [get_pins {_2910_/Q}]
set_input_delay 0.3 -clock g3 [all_inputs]
set_output_delay 0.5 -clock clk_i [all_outputs]
set_output_delay 0.2 -clock ge -add_delay [get_ports {irq_o}]
set_output_delay 0.4 -clock gi -add_delay [get_ports {tl_o[3]}]
create_generated_clock -name g3q -source [get_ports {clk_i}] -master_clock clk_i -multiply_by 3 -duty_cycle 90 [get_pins {_2912_/Q}]
