create_clock -name clk_i -period 2.5 [get_ports {clk_i}]
set_input_delay 0.4 -clock clk_i [all_inputs]
set_output_delay 0.6 -clock clk_i [all_outputs]
set_false_path -through [get_nets {_0930_}]
set_false_path -setup -from [get_ports {tl_i[*]}] -through [get_cells {_20*_}] -to [get_ports {tl_o[*]}]
set_false_path -hold -through [get_pins {_2100_/A1}] -through [get_nets {_0320_}]
set_multicycle_path 2 -through [get_cells {_21*_}]
set_multicycle_path -setup 3 -from [get_ports {intr_src_i[*]}] -through [get_pins {_2000_/X}]
set_multicycle_path -hold 1 -through [get_ports {tl_i[5]}] -to [get_ports {tl_o[*]}]
set_false_path -through [get_ports {intr_src_i[3]}]
set_multicycle_path -setup 2 -to [get_ports {tl_o[*]}]
set_multicycle_path -setup 4 -through [get_cells {_14*_}] -to [get_ports {tl_o[*]}]
