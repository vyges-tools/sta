create_clock -name clk_i -period 2.5 [get_ports {clk_i}]
set_input_delay 0.4 -clock clk_i [all_inputs]
set_output_delay 0.6 -clock clk_i [all_outputs]
group_path -name in2reg -from [get_ports {tl_i[*] intr_src_i[*]}] -to [get_pins {*/D}]
set_false_path -from [get_ports {tl_i[1*]}]
group_path -name to_tl -to [get_ports {tl_o[*]}]
set_false_path -from [get_ports {tl_i[*]}] -to [get_ports {tl_o[*]}]
set_multicycle_path 2 -setup -from [get_pins {*/CLK}] -to [get_pins {_29*_/D}]
group_path -name reg2reg -from [get_pins {*/CLK}] -to [get_pins {_29*_/D}]
set_false_path -hold -from [get_ports rst_ni]
group_path -name reg2out -from [get_pins {*/CLK}] -to [get_ports {tl_o[*] irq_o}]
set_false_path -to [get_ports irq_o]
