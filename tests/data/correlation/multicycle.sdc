create_clock -name clk_i -period 2.5 [get_ports {clk_i}]
set_input_delay 0.4 -clock clk_i [all_inputs]
set_output_delay 0.6 -clock clk_i [all_outputs]
set_multicycle_path 2 -from [get_ports {tl_i[*]}]
set_multicycle_path -setup 3 -to [get_ports {tl_o[*]}]
set_multicycle_path -hold 1 -to [get_ports {tl_o[*]}]
set_multicycle_path -setup 4 -start -from [get_ports rst_ni] -to [get_ports irq_o]
set_multicycle_path -hold 2 -end -from [get_ports rst_ni]
set_multicycle_path -setup 5 -from [get_ports {tl_i[100] tl_i[108]}]
set_false_path -from [get_ports {tl_i[3]}]
