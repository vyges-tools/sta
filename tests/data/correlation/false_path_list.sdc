create_clock -name clk_i -period 2.5 [get_ports {clk_i}]
set_input_delay 0.4 -clock clk_i [all_inputs]
set_output_delay 0.6 -clock clk_i [all_outputs]
set_false_path -from [list [get_ports {rst_ni}] [get_ports {intr_src_i[3]}]]
set_false_path -to [list [get_ports {irq_o}]]
set_false_path -from [list [get_ports {tl_i[1*]}] [list [get_ports {tl_i[2*]}] [get_ports {tl_i[3*]}]]] -to [concat [get_ports {tl_o[0]}] [list [get_ports {tl_o[1*]}]]]
set_false_path -hold -from [list [list [get_ports {tl_i[100]}]] [get_ports {tl_i[108]}]]
set_multicycle_path -setup 2 -through [list [get_cells {_21*_}] [list [get_pins {_2000_/X}]]] -to [list [get_ports {tl_o[2*]}]]
group_path -name in2out -from [list [get_ports {tl_i[4*]}] [list [get_ports {tl_i[5*]}]]] -to [list [get_ports {tl_o[*]}]]
