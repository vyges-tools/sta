/* A cut-down clock-gate library of our own for the partial-cond-arc rule: ICG's GCLK has a
   default CLK->GCLK set (rise and fall) and two conditional sets with the fall arc alone, as
   asap7's ICGx1 does. */
library (icg) {
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  capacitive_load_unit (1, pf) ;
  pulling_resistance_unit : "1kohm" ;
  leakage_power_unit : "1nW" ;
  nom_voltage : 1.0 ;
  nom_temperature : 25 ;
  nom_process : 1.0 ;
  input_threshold_pct_rise : 50 ;
  input_threshold_pct_fall : 50 ;
  output_threshold_pct_rise : 50 ;
  output_threshold_pct_fall : 50 ;
  slew_lower_threshold_pct_rise : 20 ;
  slew_upper_threshold_pct_rise : 80 ;
  slew_lower_threshold_pct_fall : 20 ;
  slew_upper_threshold_pct_fall : 80 ;
  cell (TIEHI) {
    area : 1 ;
    pin (H) { direction : output ; function : "1" ; }
  }
  cell (TIELO) {
    area : 1 ;
    pin (L) { direction : output ; function : "0" ; }
  }
  cell (ICG) {
    area : 2 ;
    pin (CLK) { direction : input ; clock : true ; capacitance : 0.001 ; }
    pin (ENA) { direction : input ; capacitance : 0.001 ; }
    pin (SE) { direction : input ; capacitance : 0.001 ; }
    pin (GCLK) {
      direction : output ;
      timing () {
        related_pin : "CLK" ;
        timing_sense : positive_unate ;
        cell_rise (scalar) { values ("0.10") ; }
        rise_transition (scalar) { values ("0.02") ; }
        cell_fall (scalar) { values ("0.09") ; }
        fall_transition (scalar) { values ("0.02") ; }
      }
      timing () {
        related_pin : "CLK" ;
        timing_sense : positive_unate ;
        when : "!ENA&!SE" ;
        cell_fall (scalar) { values ("0.08") ; }
        fall_transition (scalar) { values ("0.02") ; }
      }
      timing () {
        related_pin : "CLK" ;
        timing_sense : positive_unate ;
        when : "ENA|(!ENA&SE)" ;
        cell_fall (scalar) { values ("0.07") ; }
        fall_transition (scalar) { values ("0.02") ; }
      }
    }
  }
  cell (DFF) {
    area : 4 ;
    ff (IQ, IQN) { clocked_on : "CLK" ; next_state : "D" ; }
    pin (CLK) { direction : input ; clock : true ; capacitance : 0.001 ; }
    pin (D) {
      direction : input ;
      capacitance : 0.001 ;
      timing () {
        related_pin : "CLK" ;
        timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.05") ; }
        fall_constraint (scalar) { values ("0.05") ; }
      }
    }
    pin (Q) {
      direction : output ;
      function : "IQ" ;
      timing () {
        related_pin : "CLK" ;
        timing_type : rising_edge ;
        cell_rise (scalar) { values ("0.12") ; }
        rise_transition (scalar) { values ("0.02") ; }
        cell_fall (scalar) { values ("0.11") ; }
        fall_transition (scalar) { values ("0.02") ; }
      }
    }
  }
}
